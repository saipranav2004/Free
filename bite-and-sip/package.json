{
  "name": "bite-and-sip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO_MODE=true vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "E2E_BACKEND=supabase playwright test",
    "seed:generate": "node scripts/generate-seed.mjs",
    "staff:create": "node scripts/create-staff.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed:sample-history": "node scripts/seed-sample-history.mjs",
    "video:record": "node scripts/video/record.mjs http://localhost:4175 /tmp/bitesip-video && node scripts/video/overlays.mjs /tmp/bitesip-video && python3 scripts/video/compose.py /tmp/bitesip-video docs/media/walkthrough.mp4"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
