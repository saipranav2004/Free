  "oracle": [
    {
      "id": "sqlplus",
      "kind": "cli",
      "command": "sqlplus",
      "args": [],
      "credential_injection": "oracle_login_script",
      "discovery": {
        "binary_names": [
          "sqlplus"
        ],
        "windows_app_paths": [
          "sqlplus.exe"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\oracle\\instantclient*\\sqlplus.exe",
            "C:\\oracle\\product\\*\\*\\bin\\sqlplus.exe",
            "C:\\app\\*\\product\\*\\client_1\\bin\\sqlplus.exe",
            "C:\\app\\*\\product\\*\\dbhome_1\\bin\\sqlplus.exe",
            "C:\\instantclient*\\sqlplus.exe",
            "C:\\Program Files\\Oracle\\instantclient*\\sqlplus.exe",
            "C:\\Users\\*\\Downloads\\instantclient*\\sqlplus.exe",
            "C:\\Users\\*\\Downloads\\instantclient*\\*\\sqlplus.exe"
          ],
          "darwin": [
            "/opt/homebrew/bin/sqlplus",
            "/usr/local/bin/sqlplus",
            "/opt/oracle/instantclient*/sqlplus",
            "~/Downloads/instantclient*/sqlplus"
          ],
          "linux": [
            "/usr/lib/oracle/*/client64/bin/sqlplus",
            "/opt/oracle/instantclient*/sqlplus",
            "/usr/local/instantclient*/sqlplus",
            "~/Downloads/instantclient*/sqlplus"
          ]
        }
      },
      "install_hint": "Install the Oracle Instant Client 'Basic' and 'SQL*Plus' packages from oracle.com/database/technologies/instant-client, then put its directory on PATH."
    },
    {
      "id": "sqlcl",
      "kind": "cli",
      "command": "sql",
      "args": [],
      "credential_injection": "oracle_login_script",
      "discovery": {
        "binary_names": [
          "sql"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\sqlcl\\bin\\sql.exe",
            "C:\\Program Files\\sqlcl\\bin\\sql.exe",
            "C:\\Users\\*\\Downloads\\sqlcl*\\bin\\sql.exe"
          ],
          "darwin": [
            "/opt/homebrew/bin/sql",
            "/usr/local/bin/sql",
            "/opt/sqlcl/bin/sql",
            "~/Downloads/sqlcl*/bin/sql"
          ],
          "linux": [
            "/opt/sqlcl/bin/sql",
            "/usr/local/sqlcl/bin/sql",
            "~/Downloads/sqlcl*/bin/sql"
          ]
        }
      },
      "install_hint": "Download Oracle SQLcl from oracle.com/database/sqldeveloper/technologies/sqlcl and put its bin directory on PATH. It needs a Java 11 or newer runtime."
    },
    {
      "id": "sqldeveloper",
      "kind": "gui",
      "command": "sqldeveloper",
      "args": [],
      "credential_injection": "clipboard",
      "discovery": {
        "binary_names": [
          "sqldeveloper"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\Program Files\\sqldeveloper\\sqldeveloper.exe",
            "C:\\sqldeveloper\\sqldeveloper.exe",
            "C:\\Users\\*\\Downloads\\sqldeveloper*\\sqldeveloper.exe"
          ],
          "linux": [
            "/opt/sqldeveloper/sqldeveloper",
            "/usr/local/sqldeveloper/sqldeveloper"
          ]
        },
        "mac_app_bundles": [
          "SQLDeveloper.app",
          "SQL Developer.app"
        ]
      },
      "install_hint": "Download Oracle SQL Developer from oracle.com/database/sqldeveloper and install it for your platform."
    },
    {
      "id": "oracle-web",
      "kind": "browser",
      "command": "{{.ConsoleURL}}",
      "args": [],
      "credential_injection": "clipboard"
    }
  ],
