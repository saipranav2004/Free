{
  "redis": [
    {
      "id": "redis-cli",
      "kind": "cli",
      "command": "redis-cli",
      "args": [
        "-h",
        "{{.Host}}",
        "-p",
        "{{.Port}}"
      ],
      "credential_injection": "env",
      "credential_env_var": "REDISCLI_AUTH",
      "discovery": {
        "binary_names": [
          "redis-cli"
        ],
        "windows_app_paths": [
          "redis-cli.exe"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\Program Files\\Redis\\redis-cli.exe",
            "C:\\Redis\\redis-cli.exe"
          ],
          "darwin": [
            "/opt/homebrew/bin/redis-cli",
            "/usr/local/bin/redis-cli"
          ],
          "linux": [
            "/usr/bin/redis-cli",
            "/usr/local/bin/redis-cli"
          ]
        }
      },
      "install_hint": "macOS 'brew install redis', Debian/Ubuntu 'sudo apt install redis-tools', Windows: install Redis Insight or use WSL."
    },
    {
      "id": "redisinsight",
      "kind": "gui",
      "command": "RedisInsight",
      "args": [],
      "credential_injection": "none",
      "discovery": {
        "windows_app_paths": [
          "RedisInsight.exe"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\Program Files\\RedisInsight\\RedisInsight.exe",
            "C:\\Users\\*\\AppData\\Local\\Programs\\RedisInsight\\RedisInsight.exe"
          ],
          "linux": [
            "/opt/RedisInsight/RedisInsight",
            "/usr/bin/redisinsight"
          ]
        },
        "mac_app_bundles": [
          "RedisInsight.app",
          "RedisInsight-v2.app"
        ]
      },
      "install_hint": "Download Redis Insight from redis.io/insight and install it for your platform."
    }
  ],
  "postgresql": [
    {
      "id": "psql",
      "kind": "cli",
      "command": "psql",
      "args": [
        "-h",
        "{{.Host}}",
        "-p",
        "{{.Port}}",
        "-U",
        "{{.AccountName}}",
        "-d",
        "{{.DatabaseName}}"
      ],
      "credential_injection": "pgpass",
      "discovery": {
        "binary_names": [
          "psql"
        ],
        "windows_app_paths": [
          "psql.exe"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\Program Files\\PostgreSQL\\*\\bin\\psql.exe"
          ],
          "darwin": [
            "/Applications/Postgres.app/Contents/Versions/*/bin/psql",
            "/opt/homebrew/opt/postgresql*/bin/psql",
            "/usr/local/opt/postgresql*/bin/psql",
            "/opt/homebrew/bin/psql",
            "/usr/local/bin/psql",
            "/opt/homebrew/opt/libpq/bin/psql",
            "/usr/local/opt/libpq/bin/psql"
          ],
          "linux": [
            "/usr/bin/psql",
            "/usr/lib/postgresql/*/bin/psql",
            "/usr/local/bin/psql",
            "/usr/local/pgsql/bin/psql"
          ]
        }
      },
      "install_hint": "macOS 'brew install libpq' then link it, Debian/Ubuntu 'sudo apt install postgresql-client', Windows: run the EnterpriseDB PostgreSQL installer and tick Command Line Tools."
    },
    {
      "id": "pgadmin4",
      "kind": "gui",
      "command": "pgAdmin4",
      "args": [],
      "credential_injection": "pgadmin_preseed",
      "discovery": {
        "windows_app_paths": [
          "pgAdmin4.exe"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\Program Files\\pgAdmin 4\\*\\pgAdmin4.exe",
            "C:\\Program Files (x86)\\pgAdmin 4\\*\\pgAdmin4.exe",
            "C:\\Program Files\\PostgreSQL\\*\\pgAdmin 4\\runtime\\pgAdmin4.exe",
            "C:\\Program Files (x86)\\PostgreSQL\\*\\pgAdmin 4\\runtime\\pgAdmin4.exe"
          ],
          "linux": [
            "/usr/pgadmin4/bin/pgadmin4",
            "/usr/local/bin/pgadmin4"
          ]
        },
        "mac_app_bundles": [
          "pgAdmin 4.app"
        ]
      },
      "install_hint": "Download pgAdmin 4 from pgadmin.org/download and install it for your platform."
    }
  ],
  "mongodb": [
    {
      "id": "mongosh",
      "kind": "cli",
      "command": "mongosh",
      "args": [],
      "credential_injection": "mongo_init_file",
      "discovery": {
        "binary_names": [
          "mongosh"
        ],
        "windows_app_paths": [
          "mongosh.exe"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\Program Files\\mongosh\\mongosh.exe",
            "C:\\Program Files\\MongoDB\\mongosh\\mongosh.exe",
            "C:\\Program Files\\MongoDB\\Server\\*\\bin\\mongosh.exe",
            "C:\\Program Files\\MongoDB\\Tools\\*\\bin\\mongosh.exe",
            "C:\\Program Files (x86)\\mongosh\\mongosh.exe",
            "C:\\Users\\*\\AppData\\Local\\Programs\\mongosh\\mongosh.exe",
            "C:\\Users\\*\\AppData\\Local\\mongosh\\mongosh.exe",
            "C:\\Users\\*\\AppData\\Roaming\\npm\\mongosh.cmd",
            "C:\\Users\\*\\scoop\\shims\\mongosh.exe",
            "C:\\ProgramData\\chocolatey\\bin\\mongosh.exe",
            "C:\\Users\\*\\Downloads\\mongosh*\\bin\\mongosh.exe",
            "C:\\Users\\*\\Downloads\\mongosh*\\mongosh.exe",
            "C:\\Users\\*\\Downloads\\mongosh.exe",
            "C:\\mongosh\\mongosh.exe",
            "C:\\mongosh*\\bin\\mongosh.exe"
          ],
          "darwin": [
            "/opt/homebrew/bin/mongosh",
            "/usr/local/bin/mongosh",
            "/opt/homebrew/opt/mongosh/bin/mongosh",
            "~/.local/bin/mongosh",
            "~/Downloads/mongosh*/bin/mongosh",
            "~/Downloads/mongosh*/mongosh",
            "~/Downloads/mongosh"
          ],
          "linux": [
            "/usr/bin/mongosh",
            "/usr/local/bin/mongosh",
            "/snap/bin/mongosh",
            "/opt/mongosh/bin/mongosh",
            "~/.local/bin/mongosh",
            "~/Downloads/mongosh*/bin/mongosh",
            "~/Downloads/mongosh*/mongosh",
            "~/Downloads/mongosh"
          ]
        }
      },
      "install_hint": "macOS 'brew install mongosh', Debian/Ubuntu install the mongodb-mongosh package from the MongoDB apt repository, Windows: download the mongosh msi from mongodb.com/try/download/shell."
    },
    {
      "id": "mongodb-compass",
      "kind": "gui",
      "command": "MongoDBCompass",
      "args": [
        "--trustedConnectionString"
      ],
      "credential_injection": "connection_string_arg",
      "discovery": {
        "windows_app_paths": [
          "MongoDBCompass.exe"
        ],
        "absolute_path_globs": {
          "windows": [
            "C:\\Program Files\\MongoDB Compass\\MongoDBCompass.exe",
            "C:\\Users\\*\\AppData\\Local\\MongoDBCompass\\MongoDBCompass.exe"
          ],
          "linux": [
            "/opt/mongodb-compass/mongodb-compass",
            "/usr/bin/mongodb-compass"
          ]
        },
        "mac_app_bundles": [
          "MongoDB Compass.app"
        ]
      },
      "install_hint": "Download MongoDB Compass from mongodb.com/try/download/compass and install it for your platform."
    },
    {
      "id": "mongodb-web",
      "kind": "browser",
      "command": "{{.ConsoleURL}}",
      "args": [],
      "credential_injection": "clipboard"
    }
  ],
